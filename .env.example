# Copy this file to .env and adjust it for your LAN and storage layout.
XBOX_IP=192.168.1.250
XBOX_DATA_DIR=./run-data
XBOX_CERT_DIR=./certs
XBOX_NETWORK=xbox_macvlan

# Leave empty to generate a persistent admin password in /data/web-token.
# Web username is admin. Do not commit your .env or password file.
XBOX_WEB_TOKEN=

# After validation, an immutable sha-* tag or @sha256:... digest can be used.
XBOX_IMAGE=ghcr.io/rosemengzi/xbox-speedup:latest
# Adjust only when the management HTTP listener is not :8080.
XBOX_HEALTH_URL=http://127.0.0.1:8080/healthz
